# Servidor
APP_ENV=development
APP_DEBUG=true

# Base de datos
DB_HOST=localhost
DB_USER=tu_usuario_aqui
DB_PASS=tu_contraseña_aqui
DB_NAME=cipher_forge
DB_PORT=3306
DB_CHARSET=utf8mb4

# JWT (CF-13)
JWT_SECRET=tu_clave_secreta_jwt_aqui

# Cookies de sesión (JWT + Cookies)
# El JWT viaja en una cookie HttpOnly (inaccesible a JavaScript).
# COOKIE_SECURE=true únicamente en producción (HTTPS); en desarrollo HTTP déjalo en false.
COOKIE_NAME=cipher_forge_token
COOKIE_SECURE=false
COOKIE_SAMESITE=Strict

# Sistema (H02)
SISTEMA_ALLOWED_IPS=

# Frontend (Colaborativo)
FRONTEND_URL=http://localhost:8080